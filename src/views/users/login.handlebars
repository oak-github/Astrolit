<main class="center">
    <h1>Entrar em uma conta</h1>
    <div id="addBookC" class="card">
        {{#if errors}}
        <div class="errors">
            <ul class="errors_list">
                
            {{#each errors}}
            <li class="error_format"><p>{{error}}</p></li>
            {{/each}}
            
            </ul>
            </div>
        {{/if}}
        <form class="center" id="addBook" action="login" method="post">
            <label for="email">Email:</label>
            <input value="{{tUser.email}}" autocomplete="off" name="email" type="text">
            <label for="password">Senha:</label>
            <input value="{{tUser.password}}" autocomplete="off" name="password" type="password">
            <button type="submit">Entrar</button>
        </form>
        <a class="center" href="register">Não tem uma conta?</a>
    </div>
</main>